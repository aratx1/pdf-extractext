# Copia este archivo a `.env` y rellena los valores.
#   cp .env.example .env

# --- Aplicación ---
# Nombre mostrado en la documentación de FastAPI (/docs).
APP_NAME=PDF Summarizer
# Directorio donde se guardan los PDFs subidos (relativo a la raíz del proyecto).
UPLOAD_DIR=uploads
# Tamaño máximo permitido por PDF, en megabytes.
MAX_FILE_SIZE_MB=10

# --- MongoDB ---
# En local: mongodb://localhost:27017
# Con docker compose se sobreescribe automáticamente a mongodb://mongodb:27017
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=pdf_extractext

# --- OpenRouter ---
# Genera tu API key gratis en https://openrouter.ai/keys (solo email, sin tarjeta).
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_API_URL=https://openrouter.ai/api/v1
# Identificador válido de OpenRouter. Los modelos con sufijo `:free` no tienen
# coste (sí tienen rate limits).
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
